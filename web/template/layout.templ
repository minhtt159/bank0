package template

templ layout(title string, username string) {
	<!DOCTYPE html>
	<html lang="en">
		@consoleHead("bank0 · " + title)
		<body>
			<header class="topbar">
				<span class="logo">b0</span>
				<strong>bank0</strong>
				<span>operator console</span>
				<span class="spacer"></span>
				if username != "" {
					<span class="muted">{ username }</span>
				}
				@themeSelect()
				if username != "" {
					<form method="post" action="/logout" style="margin:0">
						<button class="linkbtn" type="submit">Sign out</button>
					</form>
				}
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
