package template

// Shell is the operator-console chrome (docs/05 §3 IA): top bar + left nav +
// HTMX-swapped main panel + right rail. Nav items load the main panel (and push
// their URL, so F5 and deep links work); rows in the main panel load
// details/forms into the rail. panel is the URL the main panel loads first.
templ Shell(username string, role string, pendingApprovals int, panel string) {
	<!DOCTYPE html>
	<html lang="en">
		@consoleHead("bank0 · operator console")
		<body>
			<div id="progress"></div>
			<header class="topbar">
				<span class="logo">b0</span>
				<strong>bank0</strong>
				<span class="muted">operator console</span>
				<span class="spacer"></span>
				<span class={ "rolebadge " + role }>{ role }</span>
				<span class="muted">{ username }</span>
				@themeSelect()
				<form method="post" action="/logout" style="margin:0">
					<button class="linkbtn" type="submit">Sign out</button>
				</form>
			</header>
			<div class="layout" id="layout">
				<nav class="leftnav">
					<a class="navitem" hx-get="/console/dashboard" hx-target="#main-panel" hx-push-url="true" title="Dashboard">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg>
						<span class="label">Dashboard</span>
					</a>
					<a class="navitem" hx-get="/console/users" hx-target="#main-panel" hx-push-url="true" title="Users">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"></path></svg>
						<span class="label">Users</span>
					</a>
					<a class="navitem" hx-get="/console/accounts" hx-target="#main-panel" hx-push-url="true" title="Accounts">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2.5"></rect><path d="M2 10h20"></path></svg>
						<span class="label">Accounts</span>
					</a>
					<a class="navitem" hx-get="/console/pending" hx-target="#main-panel" hx-push-url="true" title="Transfers">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h13"></path><path d="M14 4l3 3-3 3"></path><path d="M20 17H7"></path><path d="M10 14l-3 3 3 3"></path></svg>
						<span class="label">Transfers</span>
					</a>
					<a class="navitem" hx-get="/console/reconcile" hx-target="#main-panel" hx-push-url="true" title="Reconciliation">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"></path><path d="M7 21h10"></path><path d="M4 7h16"></path><path d="M6 7l-3 6a3.2 3.2 0 0 0 6 0z"></path><path d="M18 7l-3 6a3.2 3.2 0 0 0 6 0z"></path></svg>
						<span class="label">Reconciliation</span>
					</a>
					<a class="navitem" hx-get="/console/approvals" hx-target="#main-panel" hx-push-url="true" title="Approvals">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg>
						<span class="label">Approvals</span>
						if pendingApprovals > 0 {
							<span class="badge-count">{ i64(int64(pendingApprovals)) }</span>
						}
					</a>
					<a class="navitem" hx-get="/console/limit-requests" hx-target="#main-panel" hx-push-url="true" title="Limit requests">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"></path><path d="M12 4v16"></path><circle cx="12" cy="12" r="9"></circle></svg>
						<span class="label">Limit requests</span>
					</a>
					<a class="navitem" hx-get="/console/disputes" hx-target="#main-panel" hx-push-url="true" title="Disputes">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-7"></path><path d="M4 14V4h13l-2.5 4 2.5 4z"></path></svg>
						<span class="label">Disputes</span>
					</a>
					<a class="navitem" hx-get="/console/warning-rules" hx-target="#main-panel" hx-push-url="true" title="Warning rules">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.4 8-8 10-4.6-2-8-5-8-10V6z"></path><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg>
						<span class="label">Warning rules</span>
					</a>
					<a class="navitem" hx-get="/console/watchlist" hx-target="#main-panel" hx-push-url="true" title="Watchlist">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
						<span class="label">Watchlist</span>
					</a>
					<a class="navitem" hx-get="/console/audit" hx-target="#main-panel" hx-push-url="true" title="Audit log">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6"></path><path d="M9 13h6"></path><path d="M9 17h6"></path></svg>
						<span class="label">Audit log</span>
					</a>
					<a class="navitem" hx-get="/console/settings" hx-target="#main-panel" hx-push-url="true" title="Settings">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
						<span class="label">Settings</span>
					</a>
				</nav>
				<main id="main-panel" hx-get={ panel } hx-trigger="load"></main>
				<aside id="rail-wrap" class="rail-wrap">
					<div class="rail-bar">
						<button class="rail-close" type="button" onclick="closeRail()" title="Close panel" aria-label="Close panel">×</button>
					</div>
					<div id="rail">
						<div class="rail-empty">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M9 18l6-6-6-6"></path></svg>
							<p>Select a user or row to see details.</p>
						</div>
					</div>
				</aside>
			</div>
			<div id="toasts" role="status" aria-live="polite"></div>
			<script src="/static/console.js"></script>
		</body>
	</html>
}
