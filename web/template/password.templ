package template

// PasswordScreen: staff change their own password. mustChange = the console holds
// them here until they do (00018).
templ PasswordScreen(username string, mustChange bool, flash string) {
	@layout("Change password", username) {
		<div class="panel">
			if mustChange {
				<div class="badge bad" role="alert">
					Change this password before continuing — this account still holds the
					password it was seeded with, which is published in the repository.
					Every other console screen is blocked until it is changed.
				</div>
			}
			if flash != "" {
				<div class="flash" role="status">{ flash }</div>
			}
			<h2>Change your password</h2>
			<form method="post" action="/console/password">
				<label>Current password <input name="current_password" type="password" autocomplete="current-password" required/></label>
				<label>New password <input name="new_password" type="password" autocomplete="new-password" minlength="12" required/></label>
				<label>Confirm new password <input name="confirm_password" type="password" autocomplete="new-password" minlength="12" required/></label>
				<p class="muted">At least 12 characters, and different from the current one. Other sessions are signed out.</p>
				<button class="primary" type="submit">Change password</button>
			</form>
		</div>
	}
}
